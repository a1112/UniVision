{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:univision:industrial-suite:artifact-ref:0.1",
  "title": "artifact-ref (design draft, not a production certification)",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "bytes": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "provenance": {
      "enum": [
        "synthetic",
        "imported",
        "derived"
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "path",
    "bytes",
    "sha256",
    "media_type",
    "provenance"
  ],
  "additionalProperties": false
}
