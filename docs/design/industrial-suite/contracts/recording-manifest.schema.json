{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:univision:industrial-suite:recording-manifest:0.1",
  "title": "recording-manifest (design draft, not a production certification)",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "container_format": {
      "enum": [
        "mcap-v1",
        "synthetic-fixture-v1"
      ]
    },
    "provenance": {
      "enum": [
        "synthetic",
        "imported"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "recovered",
        "corrupt"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "urn:univision:industrial-suite:artifact-ref:0.1"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "stream_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "frame_count": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "gap_ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stream_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "first": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          },
          "last": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "stream_id",
          "first",
          "last",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "closed_reason": {
      "enum": [
        "normal",
        "cancelled",
        "failure",
        "recovery"
      ]
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "container_format",
    "provenance",
    "status",
    "files",
    "stream_ids",
    "frame_count",
    "gap_ranges",
    "closed_reason",
    "notes"
  ],
  "additionalProperties": false
}
